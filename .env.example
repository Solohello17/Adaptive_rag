# Provider Selection
# Options for LLM_PROVIDER: openai, anthropic, gemini
LLM_PROVIDER=anthropic
LLM_PROVIDER_FAST=groq

# Options for EMBEDDINGS_PROVIDER: openai, gemini, local
EMBEDDINGS_PROVIDER=local

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# OpenRouter: OpenAI-compatible gateway fronting many model providers behind one key.
# Get a key at https://openrouter.ai/keys. Free-tier models carry a ":free" suffix
# (e.g. meta-llama/llama-3.1-8b-instruct:free) -- copy the exact model ID you want
# from https://openrouter.ai/models, don't guess it.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# OmniRoute: self-hosted, OpenAI-compatible AI gateway that runs locally (npm/Docker),
# fronting many providers with auto-fallback and caching. Default port 20128.
# OMNIROUTE_API_KEY is a local gateway key from the OmniRoute dashboard/CLI, not a
# provider key. Routing aliases like "auto/coding:free" pick a model dynamically --
# get the exact ID your instance supports from <OMNIROUTE_BASE_URL>/models.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=your_omniroute_gateway_key_here
OMNIROUTE_MODEL=auto/coding:free

# Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
MONGODB_URI=mongodb://localhost:27017

# Similarity safety net: overrides a web_search/general_knowledge routing decision
# when a local (no-LLM) Qdrant similarity probe scores at or above this against the
# indexed documents/code collections. Tune from the INFO-level "Similarity probe"
# log line; re-tune if you change EMBEDDINGS_PROVIDER.
ROUTER_OVERRIDE_THRESHOLD=0.6

# Log level for the app's own loggers. DEBUG also shows the grounding check's context length.
LOG_LEVEL=INFO

# Retrieval diversity: results are grouped by source document instead of a flat
# top-k, so one heavily-chunked or duplicated document can't crowd out the rest.
RETRIEVAL_DOCS_PER_QUERY=4
RETRIEVAL_CHUNKS_PER_DOC=3

# v2.0 decision layer: who makes the route / grade / verify decisions.
# llm = the v1 path, unchanged. jev = TypeSafe Jev via the Vercel AI Gateway,
# with automatic per-decision fallback to the LLM. Generation always uses the LLM.
APP_VERSION=2.0.0
DECISION_PROVIDER=llm
# Vercel AI Gateway key (free tier is enough). Never buy credits: that moves the
# account to the paid tier and ends the free monthly credit.
AI_GATEWAY_API_KEY=your_ai_gateway_api_key_here
JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
JEV_MODEL=typesafe-ai/jev
JEV_TIMEOUT_SECONDS=10
JEV_MAX_CONCURRENCY=3
# Thresholds are starting guesses, not measured. Tune them from the evaluation.
JEV_ROUTE_MIN_CONFIDENCE=0.6
JEV_GRADE_THRESHOLD=0.5
JEV_VERIFY_THRESHOLD=0.5
JEV_MAX_STATE_CHARS=60000
JEV_FALLBACK_TO_LLM=true
JEV_LOG_DECISIONS=true
