# Provider Selection
# Options for LLM_PROVIDER: openai, anthropic, gemini
LLM_PROVIDER=anthropic
LLM_PROVIDER_FAST=groq

# Options for EMBEDDINGS_PROVIDER: openai, gemini, local
EMBEDDINGS_PROVIDER=local

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# OpenRouter: OpenAI-compatible gateway fronting many model providers behind one key.
# Get a key at https://openrouter.ai/keys. Free-tier models carry a ":free" suffix
# (e.g. meta-llama/llama-3.1-8b-instruct:free) -- copy the exact model ID you want
# from https://openrouter.ai/models, don't guess it.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Database Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
MONGODB_URI=mongodb://localhost:27017
